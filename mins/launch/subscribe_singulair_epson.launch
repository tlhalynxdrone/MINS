<launch>

    <arg name="config"          default="hiiro_singulair_epson" />
    <arg name="rosbag"          default="$(env HOME)/rosbags/$(arg config).bag" />
    <arg name="bag_start_time"  default="0" />
    <arg name="realtime"  default="true" />
    <!-- MASTER NODE -->
    <node name="mins_subscribe" pkg="mins" type="subscribe" output="screen" clear_params="true" required="true">
        <param name="config_path"       type="str"  value="$(find mins)/config/$(arg config)/config.yaml" />
    </node>

    <!-- ROS BAG -->
     <node pkg="rosbag" type="play" name="rosbag" output="screen"
          args="--clock -s $(arg bag_start_time) $(arg rosbag)"
          unless="$(arg realtime)" />
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="imu_lidar_tf"
        args="-0.102127 0.014358 -0.128485  -3.133595 0.375246 -3.126658  livox_frame imu" /> -->

    <!-- <node pkg="tf2_ros" type="static_transform_publisher" unless="$(arg realtime)" name="map_to_global"
      args="0 0 0 0 0 0 map global" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="odom_to_global"
      args="0 0 0 0 0 0 odom global" />
    
    <node pkg="tf2_ros" type="static_transform_publisher" name="livox_lidar"
            args="0 0 0 0 0 0 lidar0 livox_frame" />   -->
    c
</launch>

